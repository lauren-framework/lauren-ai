# Copy this file to examples/.env and fill in the values you need for any
# example that talks to a live model provider.
#
# The current inter-agent messaging example is fully in-memory and does not
# require an API key, but future examples in this directory can read from the
# same environment shape.

# Generic provider selection
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-1

# Optional generic override used by some helper scripts
LLM_API_KEY=
LLM_BASE_URL=

# Provider-specific keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_API_KEY=

# Common local Ollama default
OLLAMA_BASE_URL=http://localhost:11434
